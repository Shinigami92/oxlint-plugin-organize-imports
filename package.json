{
  "name": "oxlint-plugin-organize-imports",
  "version": "0.0.0",
  "description": "Oxlint plugin that organizes imports using the TypeScript language service, matching the editor's 'Organize Imports' command.",
  "keywords": [
    "imports",
    "linter",
    "organize-imports",
    "oxlint",
    "oxlint-plugin",
    "typescript"
  ],
  "homepage": "https://github.com/Shinigami92/oxlint-plugin-organize-imports#readme",
  "bugs": "https://github.com/Shinigami92/oxlint-plugin-organize-imports/issues",
  "license": "MIT",
  "author": "Christopher Quadflieg <shinigami92@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shinigami92/oxlint-plugin-organize-imports.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.82.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "oxlint": "^1.0.0",
    "typescript": "^5 || ^6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
